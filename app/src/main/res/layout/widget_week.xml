<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/week_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/week_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg_light" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:paddingTop="10dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/week_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#18181B"
                android:paddingLeft="4dp"
                android:paddingRight="6dp"
                android:maxLines="1"
                android:text="第13周" />

            <TextView
                android:id="@+id/week_sub"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="10sp"
                android:textColor="#71717A"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="轻课表" />

            <TextView
                android:id="@+id/btn_prev_week"
                android:layout_width="28dp"
                android:layout_height="24dp"
                android:gravity="center"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#52525B"
                android:text="‹" />

            <TextView
                android:id="@+id/btn_next_week"
                android:layout_width="28dp"
                android:layout_height="24dp"
                android:gravity="center"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#52525B"
                android:text="›" />

            <TextView
                android:id="@+id/btn_week_refresh"
                android:layout_width="28dp"
                android:layout_height="24dp"
                android:gravity="center"
                android:textSize="13sp"
                android:textColor="#52525B"
                android:text="↻" />
        </LinearLayout>

        <ImageView
            android:id="@+id/week_canvas"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scaleType="fitXY" />
    </LinearLayout>
</FrameLayout>
