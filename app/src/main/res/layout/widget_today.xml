<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/bg_img"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg_light" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="10dp">

        <!-- 顶部：日期 + 周次胶囊 + 刷新按钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:baselineAligned="false">

            <TextView
                android:id="@+id/hdr_date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#18181B"
                android:maxLines="1"
                android:text="11月23日 周一" />

            <TextView
                android:id="@+id/hdr_week"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/chip_bg_light"
                android:paddingLeft="7dp"
                android:paddingRight="7dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#2563EB"
                android:maxLines="1"
                android:text="第13周" />

            <TextView
                android:id="@+id/btn_refresh"
                android:layout_width="28dp"
                android:layout_height="24dp"
                android:layout_marginLeft="4dp"
                android:gravity="center"
                android:textSize="14sp"
                android:textColor="#71717A"
                android:text="↻" />
        </LinearLayout>

        <TextView
            android:id="@+id/hdr_div"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp"
            android:background="#18000000" />

        <!-- 课程行 ×7：日标 + 彩色竖条 + 时间/节次 + 课程名 + 教室胶囊 -->
        <LinearLayout android:id="@+id/row1" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="2dp" android:paddingBottom="2dp">
            <TextView android:id="@+id/d1" android:layout_width="32dp" android:layout_height="wrap_content" android:textSize="10sp" android:textStyle="bold" android:textColor="#2563EB" android:maxLines="1" />
            <ImageView android:id="@+id/bar1" android:layout_width="3.5dp" android:layout_height="26dp" android:layout_marginRight="8dp" android:src="@drawable/course_bar" />
            <TextView android:id="@+id/t1" android:layout_width="42dp" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="#52525B" android:maxLines="2" android:lineSpacingExtra="1dp" />
            <TextView android:id="@+id/n1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:paddingLeft="4dp" android:paddingRight="6dp" android:textSize="13sp" android:textStyle="bold" android:textColor="#18181B" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/r1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxWidth="68dp" android:background="@drawable/chip_bg_light" android:paddingLeft="6dp" android:paddingRight="6dp" android:paddingTop="2dp" android:paddingBottom="2dp" android:textSize="10sp" android:textColor="#52525B" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>

        <LinearLayout android:id="@+id/row2" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="2dp" android:paddingBottom="2dp">
            <TextView android:id="@+id/d2" android:layout_width="32dp" android:layout_height="wrap_content" android:textSize="10sp" android:textStyle="bold" android:textColor="#71717A" android:maxLines="1" />
            <ImageView android:id="@+id/bar2" android:layout_width="3.5dp" android:layout_height="26dp" android:layout_marginRight="8dp" android:src="@drawable/course_bar" />
            <TextView android:id="@+id/t2" android:layout_width="42dp" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="#52525B" android:maxLines="2" android:lineSpacingExtra="1dp" />
            <TextView android:id="@+id/n2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:paddingLeft="4dp" android:paddingRight="6dp" android:textSize="13sp" android:textStyle="bold" android:textColor="#18181B" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/r2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxWidth="68dp" android:background="@drawable/chip_bg_light" android:paddingLeft="6dp" android:paddingRight="6dp" android:paddingTop="2dp" android:paddingBottom="2dp" android:textSize="10sp" android:textColor="#52525B" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>

        <LinearLayout android:id="@+id/row3" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="2dp" android:paddingBottom="2dp">
            <TextView android:id="@+id/d3" android:layout_width="32dp" android:layout_height="wrap_content" android:textSize="10sp" android:textStyle="bold" android:textColor="#71717A" android:maxLines="1" />
            <ImageView android:id="@+id/bar3" android:layout_width="3.5dp" android:layout_height="26dp" android:layout_marginRight="8dp" android:src="@drawable/course_bar" />
            <TextView android:id="@+id/t3" android:layout_width="42dp" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="#52525B" android:maxLines="2" android:lineSpacingExtra="1dp" />
            <TextView android:id="@+id/n3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:paddingLeft="4dp" android:paddingRight="6dp" android:textSize="13sp" android:textStyle="bold" android:textColor="#18181B" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/r3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxWidth="68dp" android:background="@drawable/chip_bg_light" android:paddingLeft="6dp" android:paddingRight="6dp" android:paddingTop="2dp" android:paddingBottom="2dp" android:textSize="10sp" android:textColor="#52525B" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>

        <LinearLayout android:id="@+id/row4" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="2dp" android:paddingBottom="2dp">
            <TextView android:id="@+id/d4" android:layout_width="32dp" android:layout_height="wrap_content" android:textSize="10sp" android:textStyle="bold" android:textColor="#71717A" android:maxLines="1" />
            <ImageView android:id="@+id/bar4" android:layout_width="3.5dp" android:layout_height="26dp" android:layout_marginRight="8dp" android:src="@drawable/course_bar" />
            <TextView android:id="@+id/t4" android:layout_width="42dp" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="#52525B" android:maxLines="2" android:lineSpacingExtra="1dp" />
            <TextView android:id="@+id/n4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:paddingLeft="4dp" android:paddingRight="6dp" android:textSize="13sp" android:textStyle="bold" android:textColor="#18181B" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/r4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxWidth="68dp" android:background="@drawable/chip_bg_light" android:paddingLeft="6dp" android:paddingRight="6dp" android:paddingTop="2dp" android:paddingBottom="2dp" android:textSize="10sp" android:textColor="#52525B" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>

        <LinearLayout android:id="@+id/row5" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="2dp" android:paddingBottom="2dp">
            <TextView android:id="@+id/d5" android:layout_width="32dp" android:layout_height="wrap_content" android:textSize="10sp" android:textStyle="bold" android:textColor="#71717A" android:maxLines="1" />
            <ImageView android:id="@+id/bar5" android:layout_width="3.5dp" android:layout_height="26dp" android:layout_marginRight="8dp" android:src="@drawable/course_bar" />
            <TextView android:id="@+id/t5" android:layout_width="42dp" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="#52525B" android:maxLines="2" android:lineSpacingExtra="1dp" />
            <TextView android:id="@+id/n5" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:paddingLeft="4dp" android:paddingRight="6dp" android:textSize="13sp" android:textStyle="bold" android:textColor="#18181B" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/r5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxWidth="68dp" android:background="@drawable/chip_bg_light" android:paddingLeft="6dp" android:paddingRight="6dp" android:paddingTop="2dp" android:paddingBottom="2dp" android:textSize="10sp" android:textColor="#52525B" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>

        <LinearLayout android:id="@+id/row6" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="2dp" android:paddingBottom="2dp">
            <TextView android:id="@+id/d6" android:layout_width="32dp" android:layout_height="wrap_content" android:textSize="10sp" android:textStyle="bold" android:textColor="#71717A" android:maxLines="1" />
            <ImageView android:id="@+id/bar6" android:layout_width="3.5dp" android:layout_height="26dp" android:layout_marginRight="8dp" android:src="@drawable/course_bar" />
            <TextView android:id="@+id/t6" android:layout_width="42dp" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="#52525B" android:maxLines="2" android:lineSpacingExtra="1dp" />
            <TextView android:id="@+id/n6" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:paddingLeft="4dp" android:paddingRight="6dp" android:textSize="13sp" android:textStyle="bold" android:textColor="#18181B" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/r6" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxWidth="68dp" android:background="@drawable/chip_bg_light" android:paddingLeft="6dp" android:paddingRight="6dp" android:paddingTop="2dp" android:paddingBottom="2dp" android:textSize="10sp" android:textColor="#52525B" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>

        <LinearLayout android:id="@+id/row7" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="2dp" android:paddingBottom="2dp">
            <TextView android:id="@+id/d7" android:layout_width="32dp" android:layout_height="wrap_content" android:textSize="10sp" android:textStyle="bold" android:textColor="#71717A" android:maxLines="1" />
            <ImageView android:id="@+id/bar7" android:layout_width="3.5dp" android:layout_height="26dp" android:layout_marginRight="8dp" android:src="@drawable/course_bar" />
            <TextView android:id="@+id/t7" android:layout_width="42dp" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="#52525B" android:maxLines="2" android:lineSpacingExtra="1dp" />
            <TextView android:id="@+id/n7" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:paddingLeft="4dp" android:paddingRight="6dp" android:textSize="13sp" android:textStyle="bold" android:textColor="#18181B" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/r7" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxWidth="68dp" android:background="@drawable/chip_bg_light" android:paddingLeft="6dp" android:paddingRight="6dp" android:paddingTop="2dp" android:paddingBottom="2dp" android:textSize="10sp" android:textColor="#52525B" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>

        <TextView
            android:id="@+id/empty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="7"
            android:gravity="center"
            android:textSize="13sp"
            android:textColor="#71717A"
            android:visibility="gone"
            android:text="最近 7 天没课" />

        <!-- 底部考试倒计时胶囊 -->
        <TextView
            android:id="@+id/hdr_exam"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/exam_strip_light"
            android:paddingLeft="9dp"
            android:paddingRight="9dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:textColor="#DC2626"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="" />
    </LinearLayout>
</FrameLayout>
